import blockchain;

array Byte2 [byte; 2];

array Bytes20 [byte; 20];

table ProposalCellData {
    status: byte,
    description: Bytes,
    requested_amount: Uint64,
    recipient_lock_hash: Bytes20,
    total_yes: Uint64,
    origin_block_number: Uint64,
}

table Vote {
    vote_amount: Uint64,
    direction: byte,
}

table Counting {
    start_hash: Byte2,
    end_hash: Byte2,
    direction: byte,
    vote_amount: Uint64,
}


table VotingConfig {
    emergent_halt: byte,
    vote_code_hash: Byte32,
    vote_hash_type: byte,
    counting_code_hash: Byte32,
    counting_hash_type: byte,
    always_success_code_hash: Byte32,
    always_success_hash_type: byte,
    yes_threshold: Uint64,
    minimal_proposal_capacity: Uint64,
    vote_duration: Uint64,
    vote_window: Uint64,
    challenge_time: Uint64,
    veto_lock_script_hash: Byte32,
    minimal_vote_amount: Uint64,
}